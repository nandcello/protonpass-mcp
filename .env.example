# Required for search_aliases and get_or_create_alias_contact.
SIMPLELOGIN_API_KEY=

# Optional SimpleLogin API configuration.
SIMPLELOGIN_API_BASE_URL=https://app.simplelogin.io
SIMPLELOGIN_TIMEOUT_MS=60000

# Optional Proton Pass CLI configuration.
PROTONPASS_CLI_PATH=pass-cli
PROTONPASS_TIMEOUT_MS=60000

# Optional credential reveal safeguards for get_login_credentials.
# Defaults to $XDG_STATE_HOME/protonpass-mcp/audit.log or ~/.local/state/protonpass-mcp/audit.log.
PROTONPASS_AUDIT_LOG=
# Positive integer; defaults to 5 reveals per rolling hour.
PROTONPASS_REVEALS_PER_HOUR=5

# Read by Proton Pass CLI itself: a dedicated session directory for the agent token login.
# PROTON_PASS_SESSION_DIR=/path/to/protonpass-mcp-session
